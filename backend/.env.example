# Evidex Backend Environment Variables
# Copy this file to .env and fill in your real values.

# Required for AI features. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: which Gemini model to use. Default below.
GEMINI_MODEL=gemini-2.0-flash

# Optional: SQLite database file path. Relative paths resolve from backend/.
DATABASE_URL=sqlite:///./evidex.db

# Optional: directory used to store uploaded PDFs during development.
UPLOAD_DIR=./uploads

# Optional: comma separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: maximum upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# Optional: log level for the FastAPI app.
LOG_LEVEL=info
